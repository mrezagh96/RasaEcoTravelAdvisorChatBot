# =============================================================================
# .env.example - the environment variables this project reads
# =============================================================================
# NO API KEY IS NEEDED to run the bot. Every variable below already has a
# working default for a normal local run, so you can ignore this file.
#
# Important: nothing in this project loads a .env file by itself (no
# python-dotenv call in the code). To change a value, set it in the shell
# before you start the process, for example:
#
#     export RASA_URL=http://localhost:5005          (Linux / macOS)
#     set RASA_URL=http://localhost:5005             (Windows cmd)
#
# With Docker Compose, put the values under `environment:` in
# docker-compose.yml instead (the file already does this for the container
# URLs).
#
# A real .env is ignored by git (see .gitignore). Only this example is kept.
# =============================================================================

# Used by streamlit_app.py - where the Streamlit page finds the Rasa server.
# RASA_URL=http://localhost:5005

# Used by actions/api_clients.py - where the action server finds the
# data service.
# DATA_SERVICES_URL=http://localhost:8000

# Used by start.sh (single-container Docker run only) - the one port the
# container serves. 7860 is the port Hugging Face Spaces expects.
# PORT=7860

# Read by data_services/carbon.py but it has NO effect: the code never calls
# Climatiq, and carbon figures always come from the local emission table.
# Leave it unset.
# CLIMATIQ_API_KEY=
